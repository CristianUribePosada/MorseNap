<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="icon" type="image/x-icon" href="~/favicon.ico" />
    <link href="https://fonts.googleapis.com/css2?family=Poppins:ital,wght@0,300;0,400;0,500;0,600;0,700;1,400&display=swap" rel="stylesheet">

    <style>
            body {
                font-family: 'Poppins', sans-serif;
                background-color: #12141c;
                color: #e2e8f0;
            }

            /* Navbar personalizado */
            .navbar-morse {
                background-color: #1a1d29;
                border-bottom: 2px solid #c59b27;
                padding-top: 0.75rem;
                padding-bottom: 0.75rem;
            }

            .navbar-brand-morse {
                font-weight: 700;
                color: #ffffff !important;
                letter-spacing: 1px;
            }

                .navbar-brand-morse span {
                    color: #c59b27;
                }

            /* Corrección de alineación vertical para el menú */
            .nav-align-custom {
                display: flex;
                align-items: center;
            }

            /* Personalización del Modal para el tema oscuro */
            .modal-content-morse {
                background-color: #1a1d29;
                border: 1px solid #2d3248;
                color: #e2e8f0;
            }

            .border-start-bronce {
                border-left: 4px solid #c59b27 !important;
            }
    </style>
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>

    <nav class="navbar navbar-expand-lg navbar-morse shadow-sm mb-5">
        <div class="container">
            <a class="navbar-brand navbar-brand-morse d-flex align-items-center" href="#">
                <i class="bi bi-activity text-warning me-2"></i>Morse<span>Nap</span>
            </a>
            <button class="navbar-toggler border-0 text-white" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse justify-content-end align-items-center" id="navbarNav">
                <ul class="navbar-nav nav-align-custom m-0 p-0">
                    <li class="nav-item d-flex align-items-center">
                        <button type="button" class="nav-link text-white btn btn-link py-1 px-2 d-flex align-items-center" data-bs-toggle="modal" data-bs-target="#aboutModal" style="text-decoration: none; box-shadow: none; border: none; background: none; font-size: 1rem; font-weight: 500;">
                            <i class="bi bi-info-circle me-2 text-warning"></i> Acerca de
                        </button>
                    </li>
                </ul>
            </div>
        </div>
    </nav>

    <div class="container">
        @RenderBody()
    </div>

    <div class="modal fade" id="aboutModal" tabindex="-1" aria-labelledby="aboutModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content modal-content-morse border-0 shadow-lg">
                <div class="modal-header border-0" style="background-color: #24293e;">
                    <h5 class="modal-title fw-bold text-white d-flex align-items-center" id="aboutModalLabel">
                        <i class="bi bi-file-earmark-text me-2 text-warning"></i> Acerca de MorseNap
                    </h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body p-4">
                    <p class="small mb-3" style="color: #e2e8f0; text-align: justify;">
                        <strong>MorseNap</strong> es una solución de software diseñada para la traducción bidireccional y precisa de mensajes de texto y código Morse internacional, con capacidades de procesamiento directo en pantalla y persistencia en archivos planos. Desarrollada como aplicación práctica para el curso de estructuras de datos jerárquicas.
                    </p>

                    <h6 class="fw-bold text-white mb-2">🚀 Arquitectura y Componentes:</h6>
                    <ul class="small ps-3 mb-4" style="color: #e2e8f0;">
                        <li class="mb-1">Traducción basada en una estructura lógica de <strong>Árbol Binario de Búsqueda</strong>, optimizando el recorrido de los símbolos sin necesidad de vectores o matrices.</li>
                        <li class="mb-1">Soporte nativo para lectura y exportación dinámica mediante flujos de entrada/salida de archivos planos (<strong>.txt</strong>).</li>
                        <li class="mb-1">Validación estricta de sintaxis en tiempo real según el estándar internacional, con detección e indicación detallada de errores.</li>
                    </ul>

                    <hr style="border-color: #2d3248; opacity: 0.6;">

                    <div class="p-3 rounded border-start border-4 border-start-bronce" style="background-color: #0f111a;">
                        <h6 class="fw-bold text-white mb-1">👨‍💻 Desarrollado por:</h6>
                        <p class="mb-0 text-warning fw-semibold fs-5">Cristian Uribe Posada</p>
                        <small class="d-block" style="color: #a0aec0;">Tecnología en Desarrollo de Software</small>
                        <small class="fw-medium" style="color: #a0aec0;">Instituto Tecnológico Metropolitano (ITM)</small>
                    </div>
                </div>
                <div class="modal-footer border-0 pt-0">
                    <button type="button" class="btn btn-secondary btn-sm fw-medium px-3" data-bs-dismiss="modal" style="background-color: #24293e; border: 1px solid #2d3248;">Entendido</button>
                </div>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>